# flip each to 1 as the real thing is proven to work; 0 = fake module
USE_REAL_YOLO=0
USE_REAL_COSMOS=0
USE_REAL_MEMORY=0
USE_REAL_LLM=0

# NVIDIA Cosmos Reason
# nvcf   = NVIDIA hosted API (build.nvidia.com): just paste your nvapi- key. Default.
# openai = self-hosted NIM/vLLM: set COSMOS_BASE_URL to its /v1
# yolo   = no Cosmos at all: captions are built from YOLO labels ("a cup on your right, mid")
COSMOS_MODE=nvcf
COSMOS_API_KEY=nvapi-...
COSMOS_MODEL=nvidia/cosmos-reason1-7b        # or nvidia/cosmos-reason2-8b if it's on build.nvidia.com for you
COSMOS_INVOKE_URL=                            # leave blank: derived from COSMOS_MODEL
COSMOS_BASE_URL=http://127.0.0.1:8001/v1      # only for COSMOS_MODE=openai
COSMOS_NUM_FRAMES=8
COSMOS_MAX_TOKENS=512

# Weights & Biases Inference + Weave
WANDB_API_KEY=
WANDB_PROJECT=team/second-sight
# fastest that answered correctly in tests (~0.3 s, thinking switched off in agent.py)
AGENT_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B

# Embeddings for semantic memory search (blank key = local hashed fallback)
EMBED_API_KEY=
EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# VAST S3
VAST_S3_ENDPOINT=
VAST_ACCESS_KEY=
VAST_SECRET_KEY=
VAST_BUCKET=second-sight

# YOLO
YOLO_WEIGHTS=yolov8n.pt
YOLO_DEVICE=cpu
NEAR_FRAC=0.45
CLOSING_GROWTH=1.15

# ElevenLabs voices (blank key = browser speech)
ELEVENLABS_API_KEY=
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_VOICE_CALM=pFZP5JQG7iQjIQuC4Bku
ELEVEN_VOICE_DOC=JBFqnCBsd6RMkjVDRZzb

# agent
PERSONA=calm
SPEAK_COOLDOWN_S=6
CLIP_SECONDS=5
